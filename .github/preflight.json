{
  "version": 1,
  "required": [
    ".github/scripts/preflight.mjs",
    ".github/scripts/preflight.checks.mjs",
    ".githooks/pre-commit",
    ".githooks/pre-push",
    ".github/scripts/change-scope.checks.mjs",
    ".github/scripts/change-scope.mjs",
    ".githooks/.gitattributes"
  ],
  "packageScripts": [
    "package.json"
  ],
  "checks": [
    [
      "node",
      "--test",
      ".github/scripts/preflight.checks.mjs"
    ],
    [
      "node",
      "--test",
      ".github/scripts/change-scope.checks.mjs"
    ]
  ],
  "programChecks": [
    [
      "npm",
      "test"
    ],
    [
      "npm",
      "run",
      "release:check-version"
    ],
    [
      "npm",
      "run",
      "build"
    ],
    [
      "cargo",
      "fmt",
      "--manifest-path",
      "src-tauri/Cargo.toml",
      "--check"
    ],
    [
      "cargo",
      "check",
      "--manifest-path",
      "src-tauri/Cargo.toml"
    ],
    [
      "cargo",
      "test",
      "--manifest-path",
      "src-tauri/Cargo.toml"
    ]
  ],
  "documentation": {
    "rootMarkdown": true,
    "files": [
      "LICENSE",
      ".github/CI.md",
      ".github/pull_request_template.md"
    ],
    "markdownDirectories": [
      "docs/"
    ],
    "runtimeDocuments": []
  },
  "generated": {},
  "excludedWorkflows": {}
}
